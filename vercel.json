{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx expo export --platform web",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": null,
  "functions": {
    "api/ai/[endpoint].ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/:path((?!api(?:/|$)).*)", "destination": "/index.html" }
  ]
}
